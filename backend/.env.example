# MingleMart backend environment - copy to .env and fill in.
#
#   cp .env.example .env
#
# Read twice: by Spring (spring.config.import, as a .properties file) when the
# app runs on your host, and by Docker Compose (env_file) when it runs in a
# container. Every name below is one the application defines for itself, so
# the same file works in both places. Real environment variables win over it.
#
# Infrastructure is never started by this project. Postgres, Redis and RabbitMQ
# are whatever you point these at: local installs or containers you run
# yourself in development, managed services in production. The keys are the
# same in both; only the values change.

# --- required ---------------------------------------------------------------

# HMAC key for access-token JWTs. Must be >= 32 bytes or the app refuses to
# start. Generate: openssl rand -base64 48
MINGLEMART_TOKEN_SECRET=change-me-this-must-be-at-least-32-bytes-long

# Google OAuth client id. Checked as the `aud` claim of every ID token, so it
# must match VITE_GOOGLE_CLIENT_ID in ../frontend/.env exactly. No client secret
# is used anywhere - the ID-token flow verifies against Google's public keys.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Base URL of the browser app. Used for emailed links, and as the default
# allowed CORS origin.
FRONTEND_URL=http://localhost:5173

# Stripe. The secret key authorises API calls; the webhook secret is what
# proves an incoming webhook came from Stripe rather than from anyone who found
# the URL. Both from the Stripe dashboard; use test-mode keys.
#
# For local webhooks, point ngrok at the app and give Stripe the tunnel:
#   ngrok http 8080
#   stripe listen --forward-to <tunnel>/api/webhooks/stripe
# `stripe listen` prints its own signing secret - use THAT one here while
# forwarding, not the dashboard's.
MINGLEMART_STRIPE_SECRET_KEY=sk_test_change_me
MINGLEMART_STRIPE_WEBHOOK_SECRET=whsec_change_me

# --- postgres ---------------------------------------------------------------
# Two URLs, and the difference matters once a pooler is involved.
#
#   DATABASE_URL         what the app connects to. Behind a pooler in prod.
#   DATABASE_DIRECT_URL  what Flyway connects to. NEVER a transaction-mode
#                        pooler: the migration lock is a session-level advisory
#                        lock, and a pooler that does not keep sessions lets two
#                        instances booting together both believe they hold it.
#
# Locally the two are the same server, so they are the same string.
DATABASE_URL=jdbc:postgresql://localhost:5432/minglemart
DATABASE_DIRECT_URL=jdbc:postgresql://localhost:5432/minglemart
DATABASE_USER=minglemart
DATABASE_PASSWORD=secret

# Production, by provider. All want sslmode=require.
#
#   Azure Database for PostgreSQL (Flexible Server)
#     direct:  jdbc:postgresql://<server>.postgres.database.azure.com:5432/minglemart?sslmode=require
#     pooled:  same host, port 6432 - the built-in PgBouncer, enable it on the
#              server first. DATABASE_URL takes 6432, DATABASE_DIRECT_URL 5432.
#
#   Prisma Postgres
#     JDBC needs the direct TCP connection string from the dashboard, not the
#     prisma+postgres:// URL (that one is for the Prisma client). Use it for
#     both URLs unless you put your own pooler in front.
#
#   Neon
#     pooled:  the hostname with "-pooler" in it, plus &prepareThreshold=0 so
#              the JDBC driver stops caching server-side prepared statements
#              the pooler will not hand back to the same session.
#     direct:  the same hostname without "-pooler".
#
# Every running instance holds DB_POOL_SIZE connections. app + worker +
# scheduler at the default is 24; count before adding replicas, and count
# against the plan's limit rather than the server's.
# DB_POOL_SIZE=8

# Which Flyway locations run. application.properties defaults to migrations
# only - the safe choice for a database you cannot easily reset. Name both to
# seed the demo catalogue into a DEVELOPMENT database.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# --- redis ------------------------------------------------------------------
# Local: no auth, no TLS. Hosted (Upstash, Redis Cloud, Azure Cache): all four,
# and the username is usually "default". Redis is a cache here and fails open,
# so a wrong value makes requests slower, not broken - watch for miss storms.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# --- rabbitmq ---------------------------------------------------------------
# Local: the image's defaults (guest only connects from localhost, which is
# fine for a host run). Hosted (CloudAMQP, Azure Service Bus via AMQP, ...):
# from the provider's amqps://USER:PASS@HOST/VHOST - the vhost is usually the
# username, and 5671 is AMQP over TLS.
#
# The management UI is on 15672 locally and is the provider's own when hosted.
# It is the fastest way to watch a queue drain or read the dead letters.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# --- mail -------------------------------------------------------------------
# Locally, Mailpit catches everything and nothing leaves the building:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# In production, a real SMTP relay with auth and STARTTLS.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@minglemart.local
MAIL_FROM_NAME=MingleMart

# --- optional ---------------------------------------------------------------

# The store's own timezone. Delivery slots are "today or tomorrow, finishing by
# 22:00" in THIS zone, not the shopper's.
# MINGLEMART_STORE_TIMEZONE=America/New_York

# Extra browser origins allowed to call /api/** with credentials. Comma
# separated, each an exact origin - a credentialed request cannot use a
# wildcard. Defaults to FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# One log line per request: method, path, status, duration.
# HTTP_LOG_REQUESTS=true

# Which roles THIS process plays. Both default to true, so a plain
# `./mvnw spring-boot:run` is the whole system in one JVM. compose.yaml sets
# them per service and those values win, so these only affect host runs.
#
#   SCHEDULER_ENABLED  the clock: sweeps, drains, alarms. Exactly one process.
#   JOBS_ENABLED       the queue consumers. Any number of processes.
# SCHEDULER_ENABLED=true
# JOBS_ENABLED=true

# Where compose pulls the image from, and which tag. Unset, compose builds
# locally and calls it minglemart-backend:local.
# IMAGE=ghcr.io/<you>/minglemart-backend
# TAG=abc1234
